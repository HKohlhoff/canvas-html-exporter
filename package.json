{
  "name": "canvas-html-exporter",
  "version": "1.1.2",
  "description": "Export canvas files as portable interactive HTML package or standalone page.",
  "main": "main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "build": "node build.mjs --production",
    "build:deploy": "node build.mjs --production --deploy",
    "test": "npm run lint && npm run typecheck && npm run test:metadata && npm run test:unit",
    "test:colors": "node scripts/run-unit-tests.mjs color-helpers.test.ts",
    "test:canvas-html": "node scripts/run-unit-tests.mjs canvas-html-rendering.test.ts",
    "test:export": "node scripts/run-unit-tests.mjs exporter-helpers.test.ts",
    "test:export-files": "node scripts/run-unit-tests.mjs export-file-helpers.test.ts",
    "test:integration": "node scripts/run-unit-tests.mjs export-package.integration.test.ts",
    "test:links": "node scripts/run-unit-tests.mjs link-helpers.test.ts",
    "test:paths": "node scripts/run-unit-tests.mjs path-helpers.test.ts",
    "test:preview": "node scripts/run-unit-tests.mjs preview-helpers.test.ts",
    "test:math": "node scripts/run-unit-tests.mjs math-rendering.test.ts",
    "test:markdown": "node scripts/run-unit-tests.mjs markdown-rendering.test.ts",
    "test:metadata": "node scripts/check-release-metadata.mjs",
    "test:unit": "node scripts/run-unit-tests.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node build.mjs --watch",
    "dev:deploy": "node build.mjs --watch --deploy",
    "build:prod": "node build.mjs --production",
    "build:prod:deploy": "node build.mjs --production --deploy",
    "dev:prod": "node build.mjs --watch --production",
    "dev:prod:deploy": "node build.mjs --watch --production --deploy",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "canvas",
    "html",
    "export"
  ],
  "author": "Holger Kohlhoff",
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "katex": "^0.16.47",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "@types/katex": "^0.16.0",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.11.0",
    "obsidian": "https://codeload.github.com/obsidianmd/obsidian-api/tar.gz/cc1744324150c632416857c98964f87b1574a5fc",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HKohlhoff/canvas-html-exporter.git"
  },
  "bugs": {
    "url": "https://github.com/HKohlhoff/canvas-html-exporter/issues"
  },
  "homepage": "https://github.com/HKohlhoff/canvas-html-exporter#readme"
}
